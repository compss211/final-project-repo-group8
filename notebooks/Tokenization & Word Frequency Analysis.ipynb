    "# ===== 扩展停用词：domain-specific + functional =====\n",
    "generic_words = {\n",
    "   # 泛用评价 / 情绪词\n",
    "    \"good\",\"great\",\"nice\",\"easy\",\"best\",\"better\",\"amazing\",\"awesome\",\n",
    "    \"bad\",\"worst\",\"ok\",\"okay\",\"fine\",\"cool\",\"love\",\"like\",\"dislike\",\n",
    "    \"yes\",\"no\",\"also\",\"still\",\"really\",\"very\",\"maybe\",\"sure\",\"hope\",\n",
    "    \"already\",\"lot\",\"far\",\"first\",\"again\",\"well\",\"free\",\"true\",\"happy\",\n",
    "\n",
    "    # 功能动词 / 虚词（语义弱）\n",
    "    \"make\",\"take\",\"keep\",\"find\",\"look\",\"give\",\"use\",\"used\",\"using\",\n",
    "    \"know\",\"work\",\"help\",\"open\",\"see\",\"come\",\"change\",\"getting\",\"received\",\n",
    "    \"search\",\"navigate\",\"place\",\"option\",\"page\",\"fix\",\"pay\",\n",
    "    \"buying\",\"selling\",\"shop\",\"shopping\",\n",
    "\n",
    "    # 时间 / 频率 / 抽象词\n",
    "    \"time\",\"day\",\"days\",\"today\",\"year\",\"years\",\n",
    "    \"since\",\"last\",\"month\",\"week\",\"ever\",\"every\",\"same\",\"list\",\"people\",\n",
    "\n",
    "    # 抽象/泛指名词\n",
    "    \"thing\",\"things\",\"stuff\",\"way\",\"point\",\"anything\",\"everything\",\"something\",\n",
    "    \"than\",\"thanx\",\"many\",\"much\",\"everyone\",\"anyone\",\n",
    "\n",
    "    # 电商通用词（弱区分平台）\n",
    "    \"price\",\"money\",\"deal\",\"sale\",\n",
    "    \"buy\",\"buyer\",\"sell\",\"seller\",\"purchase\",\"purchasing\",\n",
    "    \"shipping\",\"ship\",\"delivery\",\"courier\",\"return\",\"refund\",\"package\",\"item\",\"items\",\n",
    "    \"experience\",\"issue\",\"problem\",\"support\",\"customer\",\"service\",\"review\",\n",
    "    \"fast\",\"slow\",\"quick\",\n",
    "    \"size\",\"sizing\",\"fit\",\"quality\",\"cheap\",\"expensive\",\"material\",\"style\",\n",
    "    \"site\",\"phone\",\n",
    "    \"product\",\"products\",\"store\",\"platform\",\"online\",\"website\",\"company\",\n",
    "\n",
    "    # 交流口语词\n",
    "    \"please\",\"thanks\",\"thank\",\"hello\",\"hi\",\"everyone\",\"anyone\"\n",
    "}\n",
    "\n",
    "# ===== 词形归一: 合并复数、过去式、派生词 =====\n",
    "normalize_map = {\n",
    "    \"returns\":\"return\",\"returned\":\"return\",\"returning\":\"return\",\n",
    "    \"refunds\":\"refund\",\"refunded\":\"refund\",\"refunding\":\"refund\",\n",
    "    \"deliveries\":\"delivery\",\"delivered\":\"delivery\",\"delivering\":\"delivery\",\n",
    "    \"shipments\":\"shipment\",\"ships\":\"ship\",\n",
    "    \"sizes\":\"size\",\"sizing\":\"size\",\n",
    "    \"prices\":\"price\",\"pricy\":\"price\",\n",
    "    \"auctions\":\"auction\",\"bids\":\"bid\",\"bidding\":\"bid\",\n",
    "    \"vouchers\":\"voucher\",\"promos\":\"promo\",\"promotions\":\"promo\",\n",
    "    \"memberships\":\"membership\",\n",
    "    \"primevideo\":\"prime\",\"primegaming\":\"prime\",\n",
    "    \"products\":\"product\"\n",
    "}\n",
    "\n",
    "def normalize_word(w: str) -> str:\n",
    "    w = w.lower()\n",
    "    if w in normalize_map:\n",
    "        return normalize_map[w]\n",
    "    # 去除普通复数后缀 's'\n",
    "    if len(w) > 3 and w.endswith(\"s\") and not w.endswith(\"ss\"):\n",
    "        return w[:-1]\n",
    "    return w\n"
   ]
